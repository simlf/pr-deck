{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:monthly", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["github-actions", "gomod"],
  "dependencyDashboard": false,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "One grouped PR for all non-major updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major"
    },
    {
      "description": "Auto-merge patch updates once required CI passes",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
